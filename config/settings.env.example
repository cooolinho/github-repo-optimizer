# GitHub Repo Optimizer - central configuration
# Every value can be overridden by an environment variable of the same name,
# or by creating config/settings.local.env (gitignored).

# GitHub account whose repositories are optimized
GH_OWNER=

# Feature branch created in every repository
BRANCH_NAME=chore/readme-optimization

# Where repositories are cloned to (relative to project root)
WORKSPACE_DIR=workspace

# How many repositories are processed before asking for approval
BATCH_SIZE=5

# Skip rules applied on top of config/skiplist.txt
SKIP_FORKS=true
SKIP_ARCHIVED=true

# READMEs longer than this get split into docs/
DOCS_SPLIT_THRESHOLD_LINES=250

# Upper bound for `gh repo list`
REPO_LIST_LIMIT=300

# Commit message used by publish-repo.sh
COMMIT_MESSAGE=docs: standardize README structure and tech stack badges

# Pull request title
PR_TITLE=docs: standardize README
