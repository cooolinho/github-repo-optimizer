# GitHub token for this project.
#
# Copy to config/token.env and insert your token:
#
#     cp config/token.env.example config/token.env
#     chmod 600 config/token.env
#
# config/token.env is gitignored and must never be committed.
#
# This token is used ONLY by this project. It is passed to gh via the GH_TOKEN
# environment variable for the lifetime of a single script run, so it never
# touches ~/.config/gh/hosts.yml and never becomes your global gh identity.
#
# Minimum scope (classic token):  repo
#   - or public_repo, if you only optimize public repositories
#
# Never enable: delete_repo, admin:org, admin:public_key, admin:gpg_key,
#               admin:repo_hook, workflow, write:packages, gist, user
#
# Create one at: https://github.com/settings/tokens
# See docs/setup.md for the full reasoning.

GH_TOKEN=
